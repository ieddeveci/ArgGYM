Bootstrap: docker
From: docker.io/vllm/vllm-openai:v0.29.0-cu129

%labels
    org.arggym.runtime "TRUBA ArgGYM vLLM runtime"
    org.arggym.python "3.12"
    org.arggym.vllm "0.29.0"

%files
    hpc/vllm/requirements-vllm.txt /opt/arggym/requirements-vllm.txt
    pyproject.toml /opt/arggym/pyproject.toml

%post
    set -eu

    python3 - <<'PY'
import sys
if sys.version_info[:2] != (3, 12):
    raise SystemExit(
        f"ArgGYM TRUBA runtime requires Python 3.12; image has {sys.version.split()[0]}"
    )
print("Python:", sys.version)
PY

    # The official vLLM image ships uv; use it inside the image when present.
    # This does not require uv on TRUBA itself. Fall back to pip for resilience.
    if command -v uv >/dev/null 2>&1; then
        uv pip install --system -r /opt/arggym/requirements-vllm.txt
    else
        python3 -m pip install --no-cache-dir -r /opt/arggym/requirements-vllm.txt
    fi

    # Install the repository's declared runtime dependencies without baking the
    # repository source itself into the image. At execution time the live
    # ArgGYM checkout is bind-mounted, so code changes do not require rebuilding
    # the image unless dependency declarations change.
    python3 - <<'PY' > /opt/arggym/project-requirements.txt
import tomllib
from pathlib import Path

p = Path('/opt/arggym/pyproject.toml')
data = tomllib.loads(p.read_text(encoding='utf-8'))
for dep in data.get('project', {}).get('dependencies', []):
    if isinstance(dep, str):
        print(dep)

# The evals harness is executed inside this image via `python -m evals.run`.
# Its dependencies are intentionally not part of the published wheel, so they
# must be installed from the dedicated dependency group as runtime requirements.
for dep in data.get('dependency-groups', {}).get('evals', []):
    if isinstance(dep, str):
        print(dep)
PY

    if [ -s /opt/arggym/project-requirements.txt ]; then
        if command -v uv >/dev/null 2>&1; then
            uv pip install --system -r /opt/arggym/project-requirements.txt
        else
            python3 -m pip install --no-cache-dir -r /opt/arggym/project-requirements.txt
        fi
    fi

    # Do not run a generic pip/uv dependency check here. vLLM 0.29.0's
    # official image intentionally carries a newer NCCL package than Torch's
    # package metadata pin. A generic dependency checker reports that deliberate
    # override as a conflict even though it is part of the vLLM runtime image.
    # Instead, verify the distributions and imports ArgGYM actually requires.
    python3 - <<'PY'
import importlib.metadata as md
import sys

import hydra
import openai
import torch
import tqdm
import transformers
import vllm
import yaml

vllm_version = md.version("vllm")
transformers_version = md.version("transformers")
torch_version = md.version("torch")

def base_version(version: str) -> str:
    # PEP 440 local build metadata (for example +cu129) identifies the CUDA
    # build, not a different upstream vLLM/Transformers release.
    return version.split("+", 1)[0]

if base_version(vllm_version) != "0.29.0":
    raise SystemExit(f"wrong vLLM release: {vllm_version}")
if base_version(transformers_version) != "5.17.0":
    raise SystemExit(f"wrong transformers release: {transformers_version}")

print("Python:", sys.version.split()[0])
print("Torch:", torch_version)
print("vLLM:", vllm_version)
print("Transformers:", transformers_version)
try:
    print("NCCL Python package:", md.version("nvidia-nccl-cu12"))
except md.PackageNotFoundError:
    print("NCCL Python package: not installed as a Python distribution")
print("Runtime dependency imports: PASS")
PY

%test
    python3 - <<'PY'
import importlib.metadata as md
import sys

if sys.version_info[:2] != (3, 12):
    raise SystemExit(f"wrong Python: {sys.version}")

import hydra
import openai
import torch
import tqdm
import transformers
import vllm
import yaml

vllm_version = md.version("vllm")
transformers_version = md.version("transformers")
torch_version = md.version("torch")

def base_version(version: str) -> str:
    # PEP 440 local build metadata (for example +cu129) identifies the CUDA
    # build, not a different upstream vLLM/Transformers release.
    return version.split("+", 1)[0]

if base_version(vllm_version) != "0.29.0":
    raise SystemExit(f"wrong vLLM release: {vllm_version}")
if base_version(transformers_version) != "5.17.0":
    raise SystemExit(f"wrong transformers release: {transformers_version}")

print("Python", sys.version.split()[0])
print("vLLM", vllm_version)
print("Transformers", transformers_version)
print("PyTorch", torch_version)
print("base runtime test: PASS")
PY

%environment
    export PYTHONUNBUFFERED=1
    export TOKENIZERS_PARALLELISM=false
