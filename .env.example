# Credentials and endpoints the eval harness reads. Copy to `.env` and fill in
# the ones you use:
#
#     cp .env.example .env
#
# `python -m evals.run` loads `.env` from the directory you run it in, or the
# nearest one above it. A variable already set in your shell wins over the file.
# `.env` is gitignored. Never commit a real key, here or in a doc.
#
# Each model config names the variable it reads in `api_key_env`, and its
# endpoint through `${oc.env:...}` in `base_url`. Leave a URL unset to use the
# default written in the config.

# OpenRouter: openrouter-claude-sonnet-4.5-*, openrouter-gpt-5-*
OPENROUTER_API_KEY=

# OpenAI direct: openai-gpt-5-*
OPENAI_API_KEY=

# Google AI Studio: every aistudio-* config
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# vLLM, local or on the cluster: every hf-* config. The key must match the
# server's --api-key; any string works against a server started without one.
VLLM_API_KEY=
# VLLM_BASE_URL=http://127.0.0.1:8000/v1

# Hugging Face read token, for gated checkpoints and for the HPC lane's
# revision lookup. Your own token from huggingface.co/settings/tokens.
HF_TOKEN=
# HF_HOME=~/.cache/huggingface
